# Biological Transferability Atlas (FAIRGEN-Open / BTA)
# Ignore bulky genomics artifacts; keep code, configs, paper, and small result tables.

# --- Secrets / env ---
.env
.env.*
!.env.example
*.pem
*.key
credentials*
*token*

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Snakemake / workflow caches ---
.snakemake/
.cache/
**/hf_staging*/
**/huggingface/

# --- Genotypes & huge binary formats ---
*.vcf
*.vcf.gz
*.tbi
*.csi
*.pgen
*.pvar
*.psam
*.bed
*.bim
*.fam
*.bgen
*.bgi
*.sscore
*.geno
*.dose
*.nosex

# --- Large tabular / array dumps ---
*.parquet
*.feather
*.h5
*.hdf5
*.npy
*.npz
*.pt
*.pth
*.ckpt
*.joblib
*.pkl
*.pickle
*.zst
*.xz
*.bz2
# Keep small text results; ignore huge archives
*.zip
*.tar
*.tar.gz
*.7z

# --- Project data lakes (regenerate / download) ---
bio-transfer-atlas/data/raw/
bio-transfer-atlas/data/interim/
bio-transfer-atlas/data/processed/
bio-transfer-atlas/data/external/
bio-transfer-atlas/data/features/
bio-transfer-atlas/data/labels/
bio-transfer-atlas/data/targets/
bio-transfer-atlas/data/annotations/
# Keep small configs under modeling/; ignore large sample parquets via global *.parquet
bio-transfer-atlas/data/modeling/*
!bio-transfer-atlas/data/modeling/
!bio-transfer-atlas/data/modeling/**/
!bio-transfer-atlas/data/modeling/*.json
!bio-transfer-atlas/data/**/README.md
!bio-transfer-atlas/data/**/MANIFEST.tsv
!bio-transfer-atlas/data/**/*.yaml
!bio-transfer-atlas/data/**/*.yml
!bio-transfer-atlas/data/registry.yaml

# --- Logs & backups ---
bio-transfer-atlas/logs/
bio-transfer-atlas/backup/
bio-transfer-atlas/hf_dataset/
bio-transfer-atlas/tools/
bio-transfer-atlas/results/logs/
bio-transfer-atlas/results/figures/*.png
bio-transfer-atlas/results/figures/*.pdf
!bio-transfer-atlas/results/figures/.gitkeep

# Keep small CSV/JSON/MD result tables & reports
!bio-transfer-atlas/results/tables/
!bio-transfer-atlas/results/*.md
!bio-transfer-atlas/results/exports/**/*.csv
!bio-transfer-atlas/results/exports/**/*.md
!bio-transfer-atlas/results/exports/**/*.txt
!bio-transfer-atlas/BTA_robustness_freeze_results_20260720/
# Drop oversized / redundant result dumps
bio-transfer-atlas/results/tables/portability_report_card*.tsv
bio-transfer-atlas/results/tables/shap_xgboost_gpu_attribution.csv
bio-transfer-atlas/results/exports/
bio-transfer-atlas/scripts/_test_extract.txt
bio-transfer-atlas/preprocess.ipynb

