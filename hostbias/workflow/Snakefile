"""Hostbias preprocessing and assembly workflow.

Run from the ``hostbias`` project directory. Downstream labelling, binning, and
statistics rules extend the ``all`` target in their own rule modules.
"""

from __future__ import annotations

import csv
from pathlib import Path


configfile: "config/config.example.yaml"


PROJECT_ROOT = Path(workflow.basedir).parent.resolve()
CLI_CONFIGFILES = tuple(workflow.overwrite_configfiles or ())
ACTIVE_CONFIG = str(CLI_CONFIGFILES[-1]) if CLI_CONFIGFILES else "config/config.example.yaml"
WORK = config["paths"]["work_dir"].rstrip("/")
RESULTS = config["paths"]["results_dir"].rstrip("/")
MANIFEST = Path(config["paths"]["sample_manifest"])
if not MANIFEST.is_absolute():
    MANIFEST = PROJECT_ROOT / MANIFEST

with MANIFEST.open(newline="", encoding="utf-8") as handle:
    sample_rows = list(csv.DictReader(handle, delimiter="\t"))

SAMPLES = {
    row["sample_id"]: row
    for row in sample_rows
    if row["status"] == "primary"
}
SAMPLE_IDS = sorted(SAMPLES)
FILTER_MODES = tuple(config["filtering"]["modes"])
COMPETITIVE = config["references"]["competitive"]
COMPETITIVE_DOMAINS = ("human", "gtdb")
INDEX_PREFIX = config["references"]["grch38"]["bowtie2_index"]
INDEX_FILES = [f"{INDEX_PREFIX}.{part}.bt2" for part in (1, 2, 3, 4, "rev.1", "rev.2")]

if not SAMPLES:
    raise WorkflowError("sample manifest contains no primary samples")


rule all:
    input:
        expand(
            f"{WORK}/assembly/{{sample}}/{{mode}}/final.contigs.fa",
            sample=SAMPLE_IDS,
            mode=FILTER_MODES,
        )


rule downstream_bridge:
    input:
        expand(
            f"{RESULTS}/aggregate/assembly_qc/{{sample}}.{{mode}}.json",
            sample=SAMPLE_IDS,
            mode=FILTER_MODES,
        ),
        expand(
            f"{RESULTS}/aggregate/alignment_manifests/{{sample}}.{{mode}}.json",
            sample=SAMPLE_IDS,
            mode=FILTER_MODES,
        )


rule gate_a_endpoint_aggregates:
    input:
        expand(
            f"{RESULTS}/aggregate/sample_endpoints/{{sample}}.{{mode}}.json",
            sample=SAMPLE_IDS,
            mode=FILTER_MODES,
        )


rule validate_inputs:
    input:
        config=ACTIVE_CONFIG,
        manifest=str(MANIFEST),
    output:
        touch(f"{WORK}/validated.ok"),
    log:
        "logs/validate.log",
    conda:
        "../envs/control.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q})
        hostbias validate --config {input.config:q} > {log:q} 2>&1
        """


rule fetch_fastq_pair:
    input:
        validation=f"{WORK}/validated.ok",
    output:
        r1=protected(f"{WORK}/raw/{{sample}}_R1.fastq.gz"),
        r2=protected(f"{WORK}/raw/{{sample}}_R2.fastq.gz"),
    log:
        "logs/fetch/{sample}.log",
    params:
        url1=lambda wildcards: SAMPLES[wildcards.sample]["fastq1_url"],
        url2=lambda wildcards: SAMPLES[wildcards.sample]["fastq2_url"],
        md5_1=lambda wildcards: SAMPLES[wildcards.sample]["fastq1_md5"],
        md5_2=lambda wildcards: SAMPLES[wildcards.sample]["fastq2_md5"],
        bytes_1=lambda wildcards: SAMPLES[wildcards.sample]["fastq1_bytes"],
        bytes_2=lambda wildcards: SAMPLES[wildcards.sample]["fastq2_bytes"],
    threads:
        config["resources"]["fetch"]["threads"]
    resources:
        mem_mb=config["resources"]["fetch"]["mem_mb"],
    conda:
        "../envs/control.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q})
        python workflow/scripts/fetch_pair.py \
          --url1 {params.url1:q} --md5-1 {params.md5_1:q} --output1 {output.r1:q} \
          --url2 {params.url2:q} --md5-2 {params.md5_2:q} --output2 {output.r2:q} \
          --bytes-1 {params.bytes_1:q} --bytes-2 {params.bytes_2:q} \
          > {log:q} 2>&1
        """


rule trim_and_normalize:
    input:
        r1=f"{WORK}/raw/{{sample}}_R1.fastq.gz",
        r2=f"{WORK}/raw/{{sample}}_R2.fastq.gz",
    output:
        r1=f"{WORK}/normalized/{{sample}}_R1.fastq.gz",
        r2=f"{WORK}/normalized/{{sample}}_R2.fastq.gz",
        report=f"{WORK}/normalized/{{sample}}.fastp.json",
    log:
        "logs/preprocess/{sample}.log",
    params:
        length=config["normalization"]["read_length"],
        pairs=config["normalization"]["read_pairs"],
        seed=config["experiment"]["seed"],
        temp=lambda wildcards: f"{WORK}/normalized/.{wildcards.sample}",
    threads:
        config["resources"]["preprocess"]["threads"]
    resources:
        mem_mb=config["resources"]["preprocess"]["mem_mb"],
    conda:
        "../envs/preprocess.yaml"
    shell:
        r"""
        mkdir -p $(dirname {log:q})
        exec > {log:q} 2>&1
        rm -rf {params.temp:q}
        mkdir -p {params.temp:q}
        fastp \
          --in1 {input.r1:q} --in2 {input.r2:q} \
          --out1 {params.temp:q}/trimmed_R1.fastq.gz \
          --out2 {params.temp:q}/trimmed_R2.fastq.gz \
          --max_len1 {params.length} --max_len2 {params.length} \
          --length_required {params.length} \
          --thread {threads} --json {params.temp:q}/fastp.json \
          --html {params.temp:q}/fastp.html
        # fastp --max_len truncates tails; --length_required removes pairs that
        # became shorter. Validate that its paired outputs are exactly 100 bp
        # before one shared RNG samples pair records in lockstep.
        python workflow/scripts/validate_fastq_pair.py \
          --r1 {params.temp:q}/trimmed_R1.fastq.gz \
          --r2 {params.temp:q}/trimmed_R2.fastq.gz \
          --expected-length {params.length}
        python workflow/scripts/subsample_fastq_pair.py \
          --r1 {params.temp:q}/trimmed_R1.fastq.gz \
          --r2 {params.temp:q}/trimmed_R2.fastq.gz \
          --output1 {output.r1:q}.partial.fastq.gz \
          --output2 {output.r2:q}.partial.fastq.gz \
          --pairs {params.pairs} --seed {params.seed} \
          --expected-length {params.length}
        mv {output.r1:q}.partial.fastq.gz {output.r1:q}
        mv {output.r2:q}.partial.fastq.gz {output.r2:q}
        mv {params.temp:q}/fastp.json {output.report:q}
        rm -rf {params.temp:q}
        """


rule build_grch38_index:
    input:
        fasta=config["references"]["grch38"]["fasta"],
    output:
        index=INDEX_FILES,
    log:
        "logs/reference/grch38_index.log",
    params:
        prefix=lambda wildcards, output: str(output.index[0]).removesuffix(".1.bt2"),
    threads:
        config["resources"]["filter"]["threads"]
    resources:
        mem_mb=config["resources"]["filter"]["mem_mb"],
    conda:
        "../envs/preprocess.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q})
        mkdir -p $(dirname {params.prefix:q})
        bowtie2-build --threads {threads} {input.fasta:q} {params.prefix:q} \
          > {log:q} 2>&1
        """


rule filter_host:
    input:
        r1=f"{WORK}/normalized/{{sample}}_R1.fastq.gz",
        r2=f"{WORK}/normalized/{{sample}}_R2.fastq.gz",
        index=INDEX_FILES,
    output:
        source_r1=f"{WORK}/filtered/{{sample}}/source_R1.fastq.gz",
        source_r2=f"{WORK}/filtered/{{sample}}/source_R2.fastq.gz",
        strict_r1=f"{WORK}/filtered/{{sample}}/strict_R1.fastq.gz",
        strict_r2=f"{WORK}/filtered/{{sample}}/strict_R2.fastq.gz",
        metrics=f"{WORK}/filtered/{{sample}}/bowtie2.metrics.txt",
    log:
        "logs/filter/{sample}.log",
    params:
        index=lambda wildcards, input: str(input.index[0]).removesuffix(".1.bt2"),
        source_pattern=lambda wildcards: f"{WORK}/filtered/{wildcards.sample}/source_R%.fastq.gz",
        temp_bam=lambda wildcards: f"{WORK}/filtered/{wildcards.sample}/strict.namesort.bam",
        strict_temp_r1=lambda wildcards: (
            f"{WORK}/filtered/{wildcards.sample}/.strict_R1.partial.fastq.gz"
        ),
        strict_temp_r2=lambda wildcards: (
            f"{WORK}/filtered/{wildcards.sample}/.strict_R2.partial.fastq.gz"
        ),
    threads:
        config["resources"]["filter"]["threads"]
    resources:
        mem_mb=config["resources"]["filter"]["mem_mb"],
    conda:
        "../envs/preprocess.yaml"
    shell:
        r"""
        mkdir -p $(dirname {log:q})
        exec > {log:q} 2>&1
        mkdir -p $(dirname {output.source_r1:q})
        bowtie2 --very-sensitive-local \
          -x {params.index:q} -1 {input.r1:q} -2 {input.r2:q} \
          --threads {threads} --met-file {output.metrics:q}.partial \
          --un-conc-gz {params.source_pattern:q} \
          | samtools view -u -f 12 -F 2304 - \
          | samtools sort -n -@ {threads} -o {params.temp_bam:q} -
        samtools fastq -@ {threads} -n \
          -1 {params.strict_temp_r1:q} -2 {params.strict_temp_r2:q} \
          -0 /dev/null -s /dev/null {params.temp_bam:q}
        python workflow/scripts/validate_fastq_pair.py \
          --r1 {output.source_r1:q} --r2 {output.source_r2:q}
        python workflow/scripts/validate_fastq_pair.py \
          --r1 {params.strict_temp_r1:q} --r2 {params.strict_temp_r2:q}
        mv {params.strict_temp_r1:q} {output.strict_r1:q}
        mv {params.strict_temp_r2:q} {output.strict_r2:q}
        mv {output.metrics:q}.partial {output.metrics:q}
        rm -f {params.temp_bam:q}
        """


rule assemble:
    input:
        r1=f"{WORK}/filtered/{{sample}}/{{mode}}_R1.fastq.gz",
        r2=f"{WORK}/filtered/{{sample}}/{{mode}}_R2.fastq.gz",
    output:
        contigs=f"{WORK}/assembly/{{sample}}/{{mode}}/final.contigs.fa",
        log=f"{WORK}/assembly/{{sample}}/{{mode}}/megahit.log",
    log:
        run="logs/assembly/{sample}.{mode}.log",
    params:
        outdir=lambda wildcards: f"{WORK}/assembly/{wildcards.sample}/{wildcards.mode}",
        min_contig=config["assembly"]["min_contig_length"],
    wildcard_constraints:
        mode="|".join(FILTER_MODES),
    threads:
        config["resources"]["assembly"]["threads"]
    resources:
        mem_mb=config["resources"]["assembly"]["mem_mb"],
    conda:
        "../envs/assembly.yaml"
    shell:
        r"""
        mkdir -p $(dirname {log.run:q})
        exec > {log.run:q} 2>&1
        mkdir -p {params.outdir:q}
        rm -rf {params.outdir:q}.partial
        megahit \
          -1 {input.r1:q} -2 {input.r2:q} \
          --min-contig-len {params.min_contig} \
          --num-cpu-threads {threads} \
          --memory 0.9 \
          --out-dir {params.outdir:q}.partial
        mv {params.outdir:q}.partial/final.contigs.fa {output.contigs:q}
        mv {params.outdir:q}.partial/log {output.log:q}
        rm -rf {params.outdir:q}.partial
        """


rule assembly_qc:
    input:
        assembly=f"{WORK}/assembly/{{sample}}/{{mode}}/final.contigs.fa",
    output:
        qc=f"{RESULTS}/aggregate/assembly_qc/{{sample}}.{{mode}}.json",
    log:
        "logs/downstream/assembly_qc/{sample}.{mode}.log",
    wildcard_constraints:
        mode="|".join(FILTER_MODES),
    conda:
        "../envs/downstream.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q})
        PYTHONPATH=src python -m hostbias.cli assembly-qc \
          --assembly {input.assembly:q} \
          --sample-id {wildcards.sample:q} --filter-mode {wildcards.mode:q} \
          --output {output.qc:q} > {log:q} 2>&1
        """


rule verify_competitive_index:
    input:
        index=lambda wildcards: COMPETITIVE[wildcards.domain]["minimap2_index"],
    output:
        verified=touch(f"{WORK}/references/competitive/{{domain}}.verified"),
    log:
        "logs/downstream/reference/{domain}.log",
    params:
        expected_sha256=lambda wildcards: COMPETITIVE[wildcards.domain]["sha256"],
    wildcard_constraints:
        domain="human|gtdb",
    conda:
        "../envs/downstream.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q}) $(dirname {output.verified:q})
        printf '%s  %s\n' {params.expected_sha256:q} {input.index:q} \
          | sha256sum --check - > {log:q} 2>&1
        """


rule minimap2_version:
    output:
        version=f"{WORK}/provenance/minimap2.version",
    log:
        "logs/downstream/minimap2_version.log",
    conda:
        "../envs/downstream.yaml"
    shell:
        """
        mkdir -p $(dirname {output.version:q}) $(dirname {log:q})
        minimap2 --version > {output.version:q}.partial 2> {log:q}
        mv {output.version:q}.partial {output.version:q}
        """


rule map_competitive:
    input:
        assembly=f"{WORK}/assembly/{{sample}}/{{mode}}/final.contigs.fa",
        index=lambda wildcards: COMPETITIVE[wildcards.domain]["minimap2_index"],
        verified=f"{WORK}/references/competitive/{{domain}}.verified",
    output:
        paf=f"{WORK}/alignments/{{sample}}/{{mode}}/{{domain}}.paf",
    log:
        "logs/downstream/map/{sample}.{mode}.{domain}.log",
    params:
        preset=COMPETITIVE["mapper_preset"],
    wildcard_constraints:
        mode="|".join(FILTER_MODES),
        domain="human|gtdb",
    threads:
        config["resources"]["mapper"]["threads"]
    resources:
        mem_mb=config["resources"]["mapper"]["mem_mb"],
    conda:
        "../envs/downstream.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q}) $(dirname {output.paf:q})
        minimap2 -c -x {params.preset:q} --secondary=yes -N 5 -t {threads} \
          {input.index:q} {input.assembly:q} \
          > {output.paf:q}.partial 2> {log:q}
        mv {output.paf:q}.partial {output.paf:q}
        """


rule alignment_run_spec:
    input:
        assembly=f"{WORK}/assembly/{{sample}}/{{mode}}/final.contigs.fa",
        human_paf=f"{WORK}/alignments/{{sample}}/{{mode}}/human.paf",
        gtdb_paf=f"{WORK}/alignments/{{sample}}/{{mode}}/gtdb.paf",
        mapper_version=f"{WORK}/provenance/minimap2.version",
    output:
        spec=f"{WORK}/alignments/{{sample}}/{{mode}}/run_spec.json",
    log:
        "logs/downstream/spec/{sample}.{mode}.log",
    params:
        preset=COMPETITIVE["mapper_preset"],
        human_id=COMPETITIVE["human"]["reference_id"],
        human_sha256=COMPETITIVE["human"]["sha256"],
        gtdb_id=COMPETITIVE["gtdb"]["reference_id"],
        gtdb_sha256=COMPETITIVE["gtdb"]["sha256"],
    conda:
        "../envs/downstream.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q})
        PYTHONPATH=src python workflow/scripts/write_alignment_spec.py \
          --sample-id {wildcards.sample:q} --filter-mode {wildcards.mode:q} \
          --assembly {input.assembly:q} \
          --mapper-version-file {input.mapper_version:q} \
          --mapper-preset {params.preset:q} \
          --human-paf {input.human_paf:q} \
          --human-reference-id {params.human_id:q} \
          --human-reference-sha256 {params.human_sha256:q} \
          --gtdb-paf {input.gtdb_paf:q} \
          --gtdb-reference-id {params.gtdb_id:q} \
          --gtdb-reference-sha256 {params.gtdb_sha256:q} \
          --output {output.spec:q} > {log:q} 2>&1
        """


rule alignment_contract:
    input:
        spec=f"{WORK}/alignments/{{sample}}/{{mode}}/run_spec.json",
    output:
        # Sensitive TSV remains under work; only the manifest is publishable.
        table=f"{WORK}/analysis_inputs/{{sample}}/{{mode}}/alignments.tsv",
        manifest=f"{RESULTS}/aggregate/alignment_manifests/{{sample}}.{{mode}}.json",
    log:
        "logs/downstream/alignment_contract/{sample}.{mode}.log",
    conda:
        "../envs/downstream.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q})
        PYTHONPATH=src python -m hostbias.cli build-alignment-table \
          --spec {input.spec:q} --output-tsv {output.table:q} \
          --output-manifest {output.manifest:q} > {log:q} 2>&1
        """


rule aggregate_endpoint:
    input:
        alignments=f"{WORK}/analysis_inputs/{{sample}}/{{mode}}/alignments.tsv",
        # The binning lane publishes these two strict TSV contracts under work.
        bins=f"{WORK}/binning/{{sample}}/{{mode}}/contig_bins.tsv",
        qc=f"{WORK}/binning/{{sample}}/{{mode}}/bin_qc.tsv",
        thresholds="config/thresholds.yaml",
    output:
        endpoint=f"{RESULTS}/aggregate/sample_endpoints/{{sample}}.{{mode}}.json",
    log:
        "logs/downstream/endpoint/{sample}.{mode}.log",
    threads:
        config["resources"]["endpoint"]["threads"]
    resources:
        mem_mb=config["resources"]["endpoint"]["mem_mb"],
    conda:
        "../envs/downstream.yaml"
    shell:
        """
        mkdir -p $(dirname {log:q})
        PYTHONPATH=src python -m hostbias.cli aggregate-endpoint \
          --alignments {input.alignments:q} --contig-bins {input.bins:q} \
          --bin-qc {input.qc:q} --sample-id {wildcards.sample:q} \
          --filter-mode {wildcards.mode:q} --thresholds {input.thresholds:q} \
          --output {output.endpoint:q} > {log:q} 2>&1
        """
