{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hostbias.local/schemas/assembly_qc.schema.json",
  "title": "HostBias assembly QC aggregate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "filter_mode",
    "assembly_sha256",
    "contig_count",
    "total_bp",
    "minimum_contig_bp",
    "maximum_contig_bp",
    "n50_bp",
    "n90_bp",
    "gc_fraction_acgt",
    "n_fraction",
    "other_ambiguous_fraction",
    "privacy"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "sample_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "filter_mode": { "enum": ["source", "strict"] },
    "assembly_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "contig_count": { "type": "integer", "minimum": 1 },
    "total_bp": { "type": "integer", "minimum": 1 },
    "minimum_contig_bp": { "type": "integer", "minimum": 1 },
    "maximum_contig_bp": { "type": "integer", "minimum": 1 },
    "n50_bp": { "type": "integer", "minimum": 1 },
    "n90_bp": { "type": "integer", "minimum": 1 },
    "gc_fraction_acgt": { "type": "number", "minimum": 0, "maximum": 1 },
    "n_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "other_ambiguous_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contains_sequences",
        "contains_contig_identifiers",
        "contains_filesystem_paths"
      ],
      "properties": {
        "contains_sequences": { "const": false },
        "contains_contig_identifiers": { "const": false },
        "contains_filesystem_paths": { "const": false }
      }
    }
  }
}
